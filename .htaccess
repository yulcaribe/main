Options -Indexes

RewriteEngine On
# Serve the enhanced Pilot Briefing shell without changing the public URL.
RewriteRule ^briefing/?$ briefing/index-v2.php [L]

# Keep the public Briefing API stable for web and Android while running the
# hybrid estimated navdata auto-router, then schedule-aware local FAA NMS NOTAM enrichment.
RewriteRule ^api/v1/briefing\.php$ api/v1/briefing-auto-v2.php [L,QSA]
